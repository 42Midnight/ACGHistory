---
import {assets,entries,kinds,getPeriod} from '../lib/data';
const {id, eager=false, compact=false}=Astro.props;
const image=assets[id];
const entry=entries.find(e=>e.id===id);
const period=entry?getPeriod(entry.period):null;
---
<figure class:list={['art',{'no-image':!image,'has-image':!!image}]} style={image?`--art-src:url('${image.src}')`:undefined}>
  {image ? <><img src={image.src} alt={image.alt} loading={eager?'eager':'lazy'} decoding="async" width="720" height="960"/>{!compact&&<figcaption><a href={image.source} target="_blank" rel="noreferrer">公式图出处 ↗</a><span>{image.note}</span></figcaption>}<span class="image-error">图像暂时无法显示 · 可访问官方出处</span></> : <div class="missing-art" style={`--missing-accent:${period?.accent??'#6f756c'}`}><span class="missing-code">NO IMAGE / {entry?.year??'—'}</span><p class="missing-title">{entry?.zh??'图像档案'}</p><small>{entry?`${kinds[entry.kind]} · 公式图待收录`:'公式图待收录'}</small><em>保留出处核验后补充</em></div>}
</figure>
